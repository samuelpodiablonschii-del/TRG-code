// Beginner-friendly text and number commands.
find "Hello there" "there" found
find_position "Hello there" "there" place
replace_text "Hello there" "there" "TRG" updated
count_text "one fish two fish" "fish" how_many
starts_with "TRG language" "TRG" begins
ends_with "TRG language" "language" ends
add_numbers 5 3 total
subtract_numbers 5 3 difference
multiply_numbers 5 3 product
divide_numbers 10 2 answer
square_root 81 root
round_number 2.6 rounded
absolute_number -12 positive
minimum 5 3 smaller
maximum 5 3 bigger
distance_between 0 0 3 4 distance

say "found=" found
say "place=" place
say "updated=" updated
say "count=" how_many
say "begins=" begins
say "ends=" ends
say "total=" total
say "difference=" difference
say "product=" product
say "answer=" answer
say "root=" root
say "rounded=" rounded
say "positive=" positive
say "smaller=" smaller
say "bigger=" bigger
say "distance=" distance
say "TRG_PLAIN_ENGLISH_TESTS_PASSED"
