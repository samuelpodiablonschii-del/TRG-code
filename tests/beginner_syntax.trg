// Beginner syntax regression test.
let player = "Sam"
let score = 10
let ready = true

print "PLAYER=" player
print "SCORE=" score
print "READY=" ready

score = score + 5
print "UPDATED=" score

if ready = true (
    print "TRG_BEGINNER_TESTS_PASSED"
)
else (
    print "TRG_BEGINNER_TESTS_FAILED"
)
